{
  "name": "@nooxcord/desktop",
  "version": "0.6.0",
  "private": true,
  "description": "NooXCord desktop app",
  "author": "NooXRii",
  "main": "out/main.cjs",
  "scripts": {
    "build:main": "node build.mjs",
    "dev": "node build.mjs && concurrently -k -n web,app \"pnpm --filter @nooxcord/client dev\" \"wait-on tcp:5173 && cross-env NX_DEV_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "@nooxcord/native": "workspace:^",
    "@nooxcord/server": "workspace:^",
    "electron-updater": "^6.8.11"
  }
}
